# Root .env for `docker compose` variable substitution (local stack only).
# Copy to .env and adjust. Every value has a safe local default in
# docker-compose.yml, so this file is optional. Never use these values in a
# deployed environment.

# Must be >= 32 bytes (backend refuses to boot otherwise).
# Generate: openssl rand -base64 48
JWT_SECRET=local-dev-only-jwt-secret-please-change-0123456789abcdef

# CSRF token signing secret (falls back to JWT_SECRET when unset).
CSRF_SECRET=local-dev-only-csrf-secret-please-change-0123456789abcd

# Shared secret the Next.js server sends on SSR fetches so the backend's
# anonymous rate limiter does not throttle server-rendered pages.
INTERNAL_FETCH_SECRET=local-internal-fetch-secret-0123456789

# 1 = deterministic AI stubs (no API key needed). Set to 0 together with a real
# ANTHROPIC_API_KEY to use live Claude.
MOCK_AI=1
# ANTHROPIC_API_KEY=

# Optional: 1 = keep the job aggregator off (deterministic, no internet crawl).
DISABLE_SCHEDULER=1

# Optional: create a bootstrap admin on backend start.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=

# Optional: host ports (defaults 3000 / 4000 / 55432). Change these when the
# defaults are already taken on your machine, then `docker compose up --build`.
# FRONTEND_HOST_PORT=3000
# BACKEND_HOST_PORT=4000
# DB_HOST_PORT=55432

# Re-run the destructive demo seed on a non-empty DB (one-off):
#   docker compose run --rm -e SEED_FORCE=1 seed
