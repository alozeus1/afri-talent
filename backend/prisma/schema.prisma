model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline            String?  @db.VarChar(200)
  bio                 String?  @db.Text
  skills              String[]
  targetRoles         String[]
  targetCountries     String[]
  yearsExperience     Int?
  visaStatus          String?  @db.VarChar(100)
  linkedinUrl         String?  @db.VarChar(500)
  githubUrl           String?  @db.VarChar(500)
  portfolioUrl        String?  @db.VarChar(500)
  workHistory         Json?
  educationHistory    Json?
  certifications      Json?
  openToWork          Boolean  @default(false)
  profileCompleteness Int      @default(0)
  profileVisible      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  resumes        Resume[]
  resumeVersions CandidateResumeVersion[]

  @@index([userId])
  @@index([openToWork])
  @@index([skills])
}

model EmployerTrustProfile {
  id                           String                    @id @default(uuid())
  employerId                   String                    @unique
  employer                     Employer                  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  verificationLevel            EmployerVerificationLevel @default(UNVERIFIED)
  authenticityScore            Int                       @default(0)
  riskScore                    Int                       @default(0)
  riskLevel                    TrustRiskLevel            @default(LOW)
  postingEligibility           Boolean                   @default(false)
  requiresEnhancedVerification Boolean                   @default(false)
  verifiedDomain               String?                   @db.VarChar(255)
  websiteMatchesEmail          Boolean                   @default(false)
  throwawayDomainDetected      Boolean                   @default(false)
  linkedInCompanyUrl           String?                   @db.VarChar(500)
  domainVerifiedAt             DateTime?
  businessDocVerifiedAt        DateTime?
  manualApprovedAt             DateTime?
  premiumTrustedAt             DateTime?
  suspiciousSignals            Json?
  internalNotes                String?                   @db.Text
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  trustCases TrustCase[]

  @@index([verificationLevel])
  @@index([riskLevel, riskScore])
  @@index([postingEligibility])
}

model CandidateTrustProfile {
  id                    String                     @id @default(uuid())
  userId                String                     @unique
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationLevel     CandidateVerificationLevel @default(UNVERIFIED)
  authenticityScore     Int                        @default(0)
  riskScore             Int                        @default(0)
  riskLevel             TrustRiskLevel             @default(LOW)
  phoneNumber           String?                    @db.VarChar(30)
  phoneVerifiedAt       DateTime?
  identityVerifiedAt    DateTime?
  skillsVerifiedAt      DateTime?
  employmentVerifiedAt  DateTime?
  linkedinVerified      Boolean                    @default(false)
  githubVerified        Boolean                    @default(false)
  portfolioVerified     Boolean                    @default(false)
  premiumFilterEligible Boolean                    @default(false)
  verifiedSkillCount    Int                        @default(0)
  partnerSignalCount    Int                        @default(0)
  assessmentBacked      Boolean                    @default(false)
  fullyCompletedProfile Boolean                    @default(false)
  explainabilitySignals Json?
  suspiciousSignals     Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  phoneChallenges PhoneVerificationChallenge[]
  trustCases      TrustCase[]

  @@index([verificationLevel])
  @@index([riskLevel, riskScore])
  @@index([premiumFilterEligible])
}

model PhoneVerificationChallenge {
  id                      String                  @id @default(uuid())
  candidateTrustProfileId String
  candidateTrustProfile   CandidateTrustProfile   @relation(fields: [candidateTrustProfileId], references: [id], onDelete: Cascade)
  phoneNumber             String                  @db.VarChar(30)
  otpHash                 String                  @db.VarChar(128)
  expiresAt               DateTime
  attempts                Int                     @default(0)
  verifiedAt              DateTime?
  status                  PhoneVerificationStatus @default(PENDING)
  createdAt               DateTime                @default(now())

  @@index([candidateTrustProfileId, createdAt(sort: Desc)])
  @@index([phoneNumber, status])
}

model VerificationArtifact {
  id             String                     @id @default(uuid())
  type           VerificationArtifactType
  status         VerificationArtifactStatus @default(PENDING)
  userId         String?
  user           User?                      @relation("UserVerificationArtifacts", fields: [userId], references: [id], onDelete: SetNull)
  employerId     String?
  employer       Employer?                  @relation("EmployerVerificationArtifacts", fields: [employerId], references: [id], onDelete: SetNull)
  reviewerId     String?
  reviewer       User?                      @relation("VerificationArtifactReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  fileKey        String?                    @db.VarChar(500)
  fileName       String?                    @db.VarChar(255)
  externalUrl    String?                    @db.VarChar(500)
  metadata       Json?
  submittedAt    DateTime                   @default(now())
  reviewedAt     DateTime?
  reviewerNotes  String?                    @db.Text
  trustCase      TrustCase?
  verifiedSkills CandidateVerifiedSkill[]   @relation("CandidateVerifiedSkillArtifact")

  @@index([type, status])
  @@index([userId, submittedAt(sort: Desc)])
  @@index([employerId, submittedAt(sort: Desc)])
}

model TrustRiskEvent {
  id             String          @id @default(uuid())
  entityType     TrustEntityType
  reasonCode     String          @db.VarChar(100)
  summary        String          @db.VarChar(255)
  evidence       Json?
  scoreDelta     Int
  resultingScore Int
  riskLevel      TrustRiskLevel
  autoHeld       Boolean         @default(false)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  employerId     String?
  employer       Employer?       @relation(fields: [employerId], references: [id], onDelete: SetNull)
  jobId          String?
  job            Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId  String?
  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  threadId       String?
  thread         MessageThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([entityType, createdAt(sort: Desc)])
  @@index([riskLevel, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([employerId, createdAt(sort: Desc)])
}

model AbuseReport {
  id                  String            @id @default(uuid())
  reporterUserId      String
  reporter            User              @relation("AbuseReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUserId      String?
  reportedUser        User?             @relation("AbuseReportTargetUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  employerId          String?
  employer            Employer?         @relation(fields: [employerId], references: [id], onDelete: SetNull)
  targetJobId         String?
  targetJob           Job?              @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  targetApplicationId String?
  targetApplication   Application?      @relation(fields: [targetApplicationId], references: [id], onDelete: SetNull)
  targetThreadId      String?
  targetThread        MessageThread?    @relation(fields: [targetThreadId], references: [id], onDelete: SetNull)
  assignedAdminId     String?
  assignedAdmin       User?             @relation("AbuseReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  reason              AbuseReportReason
  details             String?           @db.Text
  status              AbuseReportStatus @default(OPEN)
  resolutionNotes     String?           @db.Text
  triagedAt           DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  trustCase           TrustCase?

  @@index([status, createdAt(sort: Desc)])
  @@index([reason, createdAt(sort: Desc)])
  @@index([reporterUserId, createdAt(sort: Desc)])
}

model TrustCase {
  id                      String                 @id @default(uuid())
  entityType              TrustEntityType
  status                  TrustCaseStatus        @default(OPEN)
  priority                TrustRiskLevel         @default(MEDIUM)
  title                   String                 @db.VarChar(200)
  reasonCode              String?                @db.VarChar(100)
  summary                 String?                @db.Text
  employerTrustProfileId  String?
  employerTrustProfile    EmployerTrustProfile?  @relation(fields: [employerTrustProfileId], references: [id], onDelete: SetNull)
  candidateTrustProfileId String?
  candidateTrustProfile   CandidateTrustProfile? @relation(fields: [candidateTrustProfileId], references: [id], onDelete: SetNull)
  jobId                   String?
  job                     Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId           String?
  application             Application?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  threadId                String?
  thread                  MessageThread?         @relation(fields: [threadId], references: [id], onDelete: SetNull)
  reportId                String?                @unique
  report                  AbuseReport?           @relation(fields: [reportId], references: [id], onDelete: SetNull)
  artifactId              String?                @unique
  artifact                VerificationArtifact?  @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  assignedAdminId         String?
  assignedAdmin           User?                  @relation("TrustCaseAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  openedAt                DateTime               @default(now())
  closedAt                DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  actions TrustCaseAction[]

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([assignedAdminId, status])
}

model TrustCaseAction {
  id         String               @id @default(uuid())
  caseId     String
  trustCase  TrustCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?                @relation("TrustCaseActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  actionType ModerationActionType
  reasonCode String?              @db.VarChar(100)
  notes      String?              @db.Text
  metadata   Json?
  createdAt  DateTime             @default(now())

  @@index([caseId, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
}

model Resume {
  id         String           @id @default(uuid())
  profileId  String
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  s3Key      String           @db.VarChar(500)
  fileName   String           @db.VarChar(255)
  isActive   Boolean          @default(false)
  uploadedAt DateTime         @default(now())

  @@index([profileId])
  @@index([profileId, isActive])
}

enum CandidateAutomationLevel {
  ASSISTED
  AUTONOMOUS
}

enum CandidateAgentTaskType {
  RESUME_REFRESH
  APPLY_PACK
  FOLLOW_UP
  INTERVIEW_PREP
  SCHEDULING
}

enum CandidateAgentTaskStatus {
  QUEUED
  RUNNING
  READY
  NEEDS_REVIEW
  SENT
  COMPLETED
  FAILED
  SKIPPED
}

enum ResumeVersionSource {
  PROFILE_SYNTHESIS
  AI_TAILOR
  USER_UPLOAD
}

enum ResumeVersionStatus {
  DRAFT
  READY
  NEEDS_REVIEW
  ARCHIVED
}

model CandidateAutopilotProfile {
  id                   String                   @id @default(uuid())
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled              Boolean                  @default(false)
  automationLevel      CandidateAutomationLevel @default(ASSISTED)
  minimumMatchScore    Int                      @default(78)
  resumeBuilderEnabled Boolean                  @default(true)
  autoApplyEnabled     Boolean                  @default(false)
  followUpEnabled      Boolean                  @default(true)
  interviewPrepEnabled Boolean                  @default(true)
  schedulingEnabled    Boolean                  @default(true)
  preferredTone        String?                  @db.VarChar(40)
  followUpCadenceDays  Int[]
  availabilityWindows  Json?
  targetCompensation   Json?
  searchStrategy       Json?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  resumeVersions CandidateResumeVersion[]
  agentTasks     CandidateAgentTask[]

  @@index([enabled, updatedAt(sort: Desc)])
}

model CandidateResumeVersion {
  id                 String                     @id @default(uuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  autopilotProfileId String?
  autopilotProfile   CandidateAutopilotProfile? @relation(fields: [autopilotProfileId], references: [id], onDelete: SetNull)
  profileId          String?
  profile            CandidateProfile?          @relation(fields: [profileId], references: [id], onDelete: SetNull)
  jobId              String?
  job                Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  aiRunId            String?
  aiRun              AiRun?                     @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  source             ResumeVersionSource
  status             ResumeVersionStatus        @default(READY)
  title              String                     @db.VarChar(160)
  targetRole         String?                    @db.VarChar(120)
  summary            String?                    @db.Text
  content            Json
  plainText          String                     @db.Text
  keywords           String[]
  score              Int?
  notes              String[]
  isPrimary          Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  agentTasks CandidateAgentTask[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isPrimary, updatedAt(sort: Desc)])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model CandidateAgentTask {
  id                 String                     @id @default(uuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  autopilotProfileId String?
  autopilotProfile   CandidateAutopilotProfile? @relation(fields: [autopilotProfileId], references: [id], onDelete: SetNull)
  applicationId      String?
  application        Application?               @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobId              String?
  job                Job?                       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  aiRunId            String?
  aiRun              AiRun?                     @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  resumeVersionId    String?
  resumeVersion      CandidateResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  type               CandidateAgentTaskType
  status             CandidateAgentTaskStatus   @default(QUEUED)
  priority           Int                        @default(50)
  title              String                     @db.VarChar(180)
  summary            String?                    @db.Text
  inputSnapshot      Json?
  outputSummary      Json?
  outputPayload      Json?
  reviewNotes        String?                    @db.Text
  scheduledFor       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  lastError          String?                    @db.VarChar(500)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([userId, status, scheduledFor])
  @@index([applicationId, type, createdAt(sort: Desc)])
  @@index([jobId, type, createdAt(sort: Desc)])
  @@index([resumeVersionId, createdAt(sort: Desc)])
}

model Company {
  id                    String                    @id @default(uuid())
  name                  String                    @db.VarChar(200)
  domain                String?                   @db.VarChar(255)
  logo                  String?                   @db.VarChar(500)
  description           String?                   @db.Text
  industry              String?                   @db.VarChar(100)
  size                  String?                   @db.VarChar(50) // 1-10, 11-50, 51-200, 201-500, 500+
  headquarters          String?                   @db.VarChar(200)
  founded               Int?
  website               String?                   @db.VarChar(500)
  linkedinUrl           String?                   @db.VarChar(500)
  verificationStatus    CompanyVerificationStatus @default(UNVERIFIED)
  sponsorshipTrustScore Float?
  hiresFromAfrica       Boolean                   @default(false)
  remotePolicy          String?                   @db.VarChar(50) // fully-remote, hybrid, office
  verifiedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  reviews              CompanyReview[]
  ratingAggregate      CompanyRatingAggregate?
  interviewExperiences InterviewExperience[]
  salaryReports        SalaryReport[]

  @@index([domain])
  @@index([verificationStatus])
  @@index([hiresFromAfrica])
}

model MessageThread {
  id            String       @id @default(uuid())
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id])
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  participants    ThreadParticipant[]
  messages        Message[]
  trustRiskEvents TrustRiskEvent[]
  abuseReports    AbuseReport[]
  trustCases      TrustCase[]

  @@index([jobId])
}

model ThreadParticipant {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id])
  joinedAt DateTime      @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id        String        @id @default(uuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("MessageSender", fields: [senderId], references: [id])
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String             @db.VarChar(255)
  body      String             @db.VarChar(1000)
  metadata  Json?
  createdAt DateTime           @default(now())

  candidateLifecycleEvents CandidateLifecycleEvent[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id                               String   @id @default(uuid())
  userId                           String   @unique
  user                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearchAlerts                Boolean  @default(true)
  weeklyDigests                    Boolean  @default(true)
  applicationReminders             Boolean  @default(true)
  profileCompletionNudges          Boolean  @default(true)
  verificationCompletionNudges     Boolean  @default(true)
  visaRelocationAlerts             Boolean  @default(true)
  salaryInsights                   Boolean  @default(true)
  interviewPrepRecommendations     Boolean  @default(true)
  interviewReminders               Boolean  @default(true)
  applicationUpdates               Boolean  @default(true)
  subscriptionNotices              Boolean  @default(true)
  marketing                        Boolean  @default(false)
  smsEnabled                       Boolean  @default(true)
  securityAlerts                   Boolean  @default(true)
  maxNotificationsPerWeek          Int      @default(6)
  minimumHoursBetweenNotifications Int      @default(18)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

