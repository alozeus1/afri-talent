  id                     String                      @id @default(uuid())
  status                 BillingReconciliationStatus @default(SUCCESS)
  triggeredBy            String                      @default("scheduler") @db.VarChar(50)
  checkedSubscriptions   Int                         @default(0)
  successPayments        Int                         @default(0)
  failedPayments         Int                         @default(0)
  webhookFailures        Int                         @default(0)
  subscriptionMismatches Int                         @default(0)
  unpaidEntitlements     Int                         @default(0)
  paidNotEntitled        Int                         @default(0)
  pendingRefunds         Int                         @default(0)
  summary                Json?
  errorMessage           String?                     @db.VarChar(500)
  startedAt              DateTime                    @default(now())
  completedAt            DateTime?
  createdAt              DateTime                    @default(now())

  discrepancies BillingDiscrepancy[]

  @@index([status, startedAt(sort: Desc)])
}

model BillingDiscrepancy {
  id                  String                    @id @default(uuid())
  userId              String?
  user                User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId      String?
  subscription        Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingEventId      String?
  billingEvent        BillingEventAudit?        @relation(fields: [billingEventId], references: [id], onDelete: SetNull)
  reconciliationRunId String?
  reconciliationRun   BillingReconciliationRun? @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull)
  type                BillingDiscrepancyType
  status              BillingDiscrepancyStatus  @default(OPEN)
  severity            String                    @default("MEDIUM") @db.VarChar(20)
  title               String                    @db.VarChar(160)
  reasonCode          String?                   @db.VarChar(120)
  details             Json?
  dueAt               DateTime?
  detectedAt          DateTime                  @default(now())
  lastSeenAt          DateTime                  @default(now())
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  updatedAt           DateTime                  @updatedAt

  supportActions BillingSupportAction[]

  @@index([status, type, detectedAt(sort: Desc)])
  @@index([userId, status, detectedAt(sort: Desc)])
  @@index([subscriptionId, status, detectedAt(sort: Desc)])
}

model BillingSupportAction {
  id             String                   @id @default(uuid())
  actorId        String
  actor          User                     @relation("BillingSupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation("BillingSupportTarget", fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingEventId String?
  billingEvent   BillingEventAudit?       @relation(fields: [billingEventId], references: [id], onDelete: SetNull)
  discrepancyId  String?
  discrepancy    BillingDiscrepancy?      @relation(fields: [discrepancyId], references: [id], onDelete: SetNull)
  actionType     BillingSupportActionType
  reasonCode     String                   @db.VarChar(120)
  notes          String?                  @db.VarChar(2000)
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([actionType, createdAt(sort: Desc)])
}

// ──────────────── AI Run Persistence ────────────────

enum AiRunStatus {
  RUNNING
  COMPLETE
  PARTIAL
  BLOCKED
}

enum AiRunType {
  RESUME_REVIEW
  JOB_MATCH
  APPLY_PACK
}

model AiRun {
  id               String      @id @default(uuid())
  runId            String      @unique
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  runType          AiRunType
  status           AiRunStatus @default(RUNNING)
  resumeHash       String?
  tokenBudgetTotal Int
  tokenBudgetUsed  Int         @default(0)
  agentCalls       Json?
  notes            String[]
  createdAt        DateTime    @default(now())
  completedAt      DateTime?

  jobs AiRunJob[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([runId])
}

model AiRunJob {
  id                String   @id @default(uuid())
  aiRunId           String
  aiRun             AiRun    @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  jobIndex          Int
  jobDbId           String?
  jobHash           String?
  jobTitle          String?
  jobCompany        String?
  jobUrl            String?
  score             Int?
  mustHavePct       Float?
  tailoredOutput    Json?
  coverLetterOutput Json?
  guardReport       Json?
  createdAt         DateTime @default(now())

  @@index([aiRunId])
}

// ──────────────── Saved Searches & Job Alerts ────────────────

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

model SavedSearch {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String         @db.VarChar(100)
  keywords        String[]
  locations       String[]
  jobTypes        String[]
  seniorities     String[]
  salaryMin       Int?
  salaryMax       Int?
  remoteOnly      Boolean        @default(false)
  visaSponsorship Boolean        @default(false)
  alertEnabled    Boolean        @default(true)
  alertFrequency  AlertFrequency @default(DAILY)
  lastAlertAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([alertEnabled, alertFrequency])
}

model JobAlert {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  searchId   String?
  matchScore Int?
  sentAt     DateTime?
  clickedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, jobId])
  @@index([userId, sentAt])
  @@index([jobId])
}

// ──────────────── Company Reviews & Ratings ────────────────

model CompanyReview {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallRating     Int // 1-5
  cultureRating     Int? // 1-5
  salaryRating      Int? // 1-5
  workLifeRating    Int? // 1-5
  managementRating  Int? // 1-5
  growthRating      Int? // 1-5
  title             String   @db.VarChar(200)
  pros              String   @db.Text
  cons              String   @db.Text
  advice            String?  @db.Text
  isCurrentEmployee Boolean  @default(false)
  employmentStatus  String?  @db.VarChar(50) // full-time, contract, intern
  jobTitle          String?  @db.VarChar(100)
  yearsAtCompany    Int?
  isVerified        Boolean  @default(false)
  isApproved        Boolean  @default(false)
  helpfulCount      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, isApproved])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model CompanyRatingAggregate {
  id                String   @id @default(uuid())
  companyId         String   @unique
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  totalReviews      Int      @default(0)
  averageOverall    Float?
  averageCulture    Float?
  averageSalary     Float?
  averageWorkLife   Float?
  averageManagement Float?
  averageGrowth     Float?
  recommendationPct Float? // % who would recommend
  updatedAt         DateTime @updatedAt
}

// ──────────────── Skills Assessment Integration ────────────────

enum AssessmentProvider {
  INTERNAL
  TESTGORILLA
  HACKERRANK
  CODILITY
  CUSTOM
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  FAILED
}

model SkillAssessment {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName   String             @db.VarChar(100)
  provider    AssessmentProvider
  externalId  String?            @db.VarChar(255)
  status      AssessmentStatus   @default(PENDING)
  score       Int? // 0-100
  percentile  Int? // 0-100
  level       String?            @db.VarChar(50) // beginner, intermediate, advanced, expert
  resultUrl   String?            @db.VarChar(500)
  metadata    Json?
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())

  verifiedSkills CandidateVerifiedSkill[]

  @@index([userId, skillName])
  @@index([status])
}

model AssessmentInvite {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String?
  provider      AssessmentProvider
  assessmentUrl String             @db.VarChar(500)
  expiresAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([userId])
  @@index([jobId])
}

// ──────────────── Interview Experiences ────────────────

model InterviewExperience {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle      String   @db.VarChar(200)
  difficulty    String   @db.VarChar(20) // easy, medium, hard
  outcome       String   @db.VarChar(20) // offered, rejected, no_response, withdrew
  interviewType String   @db.VarChar(50) // phone, video, onsite, take_home, panel
  process       String   @db.Text
  questions     String[] // array of interview questions
  tips          String?  @db.Text
  duration      String?  @db.VarChar(50) // e.g., "2 weeks", "1 month"
  isApproved    Boolean  @default(false)
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([companyId, isApproved])
  @@index([userId])
  @@index([jobTitle])
}

// ──────────────── Salary Reports ────────────────

model SalaryReport {
  id              String   @id @default(uuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle        String   @db.VarChar(200)
  location        String   @db.VarChar(200)
  country         String   @db.VarChar(100)
  salaryCurrency  String   @default("USD") @db.VarChar(10)
  salaryAmount    Int
  salaryPeriod    String   @default("yearly") @db.VarChar(20) // yearly, monthly
  yearsExperience Int?
  employmentType  String?  @db.VarChar(50) // full-time, contract, part-time
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([jobTitle, country])
  @@index([companyId])
  @@index([userId])
  @@index([country])
}

// ──────────────── Immigration Process Tracker ────────────────

enum ImmigrationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  DENIED
  EXPIRED
}

model ImmigrationProcess {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  visaType        String            @db.VarChar(100)
  targetCountry   String            @db.VarChar(100)
  status          ImmigrationStatus @default(NOT_STARTED)
  startDate       DateTime?
  expectedEndDate DateTime?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  steps ImmigrationStep[]

  @@index([userId])
  @@index([status])
}

model ImmigrationStep {
  id          String             @id @default(uuid())
  processId   String
  process     ImmigrationProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  name        String             @db.VarChar(200)
  description String?            @db.Text
  status      ImmigrationStatus  @default(NOT_STARTED)
  dueDate     DateTime?
  completedAt DateTime?
  documents   String[]
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([processId])
}

// ──────────────── Referrals ────────────────

enum ReferralStatus {
  PENDING
  ACCEPTED
  HIRED
  EXPIRED
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String
  referrer     User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeEmail String         @db.VarChar(255)
  refereeId    String?
  referee      User?          @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: SetNull)
  jobId        String?
  companyName  String?        @db.VarChar(200)
  message      String?        @db.Text
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([referrerId])
  @@index([refereeEmail])
  @@index([refereeId])
}

// ──────────────── Learning Resources ────────────────

model LearningResource {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(300)
  description   String?  @db.Text
  url           String   @db.VarChar(500)
  provider      String   @db.VarChar(100) // Coursera, Udemy, YouTube, etc.
  category      String   @db.VarChar(100) // programming, design, data-science, etc.
  skills        String[]
  difficulty    String   @db.VarChar(20) // beginner, intermediate, advanced
  durationHours Float?
  isFree        Boolean  @default(false)
  imageUrl      String?  @db.VarChar(500)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([skills])
  @@index([featured])
}

// ──────────────── Calendar Events / Interview Scheduling ────────────────

enum CalendarEventType {
  INTERVIEW
  FOLLOW_UP
  DEADLINE
  CUSTOM
}

model CalendarEvent {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String            @db.VarChar(300)
  description     String?           @db.Text
  eventType       CalendarEventType @default(CUSTOM)
  startTime       DateTime
  endTime         DateTime?
  location        String?           @db.VarChar(300)
  meetingUrl      String?           @db.VarChar(500)
  jobId           String?
  applicationId   String?
  reminderMinutes Int?              @default(30)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, startTime])
  @@index([userId, eventType])
}

// ──────────────── Job Views / Profile Analytics ────────────────

model ProfileView {
  id         String   @id @default(uuid())
  profileId  String
  viewerId   String?
  viewerRole String?  @db.VarChar(20)
  createdAt  DateTime @default(now())

  @@index([profileId, createdAt(sort: Desc)])
  @@index([viewerId])
}

// ──────────────── Password Reset ────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

// ──────────────── AI Chat Assistant ────────────────

enum ChatConsentType {
  PRIVACY_NOTICE
  TERMS_OF_USE
  DATA_STORAGE
}

model ChatConsent {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyNotice Boolean   @default(false)
  termsOfUse    Boolean   @default(false)
  dataStorage   Boolean   @default(false)
  consentedAt   DateTime?
  revokedAt     DateTime?
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  @db.VarChar(200)
  summary   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, isActive])
  @@index([userId, updatedAt(sort: Desc)])
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String           @db.Text
  metadata       Json?
  tokenCount     Int?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
