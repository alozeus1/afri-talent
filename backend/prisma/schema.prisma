// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────── Existing Enums ────────────────

enum Role {
  ADMIN
  CANDIDATE
  EMPLOYER
}

enum SupportedLocale {
  EN
  FR
  PT
  AR
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

enum ReviewStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

enum ReviewTargetType {
  JOB
  APPLICATION
  RESOURCE
}

// ──────────────── Phase A New Enums ────────────────

enum VisaSponsorshipStatus {
  YES
  NO
  UNKNOWN
}

enum JobSource {
  EMPLOYER_POSTED
  AGGREGATED
}

enum CompanyVerificationStatus {
  VERIFIED
  UNVERIFIED
  PENDING
}

enum NotificationType {
  NEW_MESSAGE
  APPLICATION_STATUS
  JOB_MATCH
  VERIFICATION
}

enum NotificationStatus {
  UNREAD
  READ
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  EMPLOYER_FREE
  EMPLOYER_BASIC
  EMPLOYER_PREMIUM
}

enum ATSProvider {
  GREENHOUSE
  LEVER
  WORKABLE
}

enum ATSConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

enum ATSSyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum MockInterviewStatus {
  DRAFT
  PROCESSING
  READY
  ARCHIVED
}

enum MockInterviewVisibility {
  PRIVATE
  TEAM_SHARED
}

enum MockInterviewArtifactType {
  VIDEO
  AUDIO
  TRANSCRIPT
  FEEDBACK_JSON
}

enum AnalyticsEventCategory {
  ACQUISITION
  ACTIVATION
  ENGAGEMENT
  CONVERSION
  RETENTION
  MONETIZATION
  EMPLOYER_PIPELINE
  SYSTEM
}

enum SocialConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum SalaryNegotiationStatus {
  DRAFT
  READY
  ARCHIVED
}

enum UniversityPartnerStatus {
  ACTIVE
  INACTIVE
}

enum PartnerOrganizationType {
  UNIVERSITY
  BOOTCAMP
  TRAINING_INSTITUTE
  SCHOLARSHIP_PARTNER
}

enum UniversityRecordType {
  INTERNSHIP
  GRADUATE_PIPELINE
  SKILLS_VERIFICATION
}

enum UniversityRecordStatus {
  RECEIVED
  VALIDATED
  REJECTED
}

enum EmployerAiTaskType {
  CANDIDATE_RANKING
  JOB_DESCRIPTION_GENERATION
}

enum EmployerAiTaskStatus {
  GENERATED
  APPROVED
  REJECTED
}

enum BotChannel {
  WHATSAPP
  TELEGRAM
}

enum BotSubscriptionStatus {
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  REVOKED
}

enum EmployerVerificationLevel {
  UNVERIFIED
  EMAIL_DOMAIN_VERIFIED
  BUSINESS_DOC_VERIFIED
  MANUAL_REVIEW_APPROVED
  PREMIUM_TRUSTED
}

enum CandidateVerificationLevel {
  UNVERIFIED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  IDENTITY_DOCUMENT_VERIFIED
  SKILLS_VERIFIED
  EMPLOYMENT_HISTORY_PARTIALLY_VERIFIED
}

enum CandidateSkillVerificationMethod {
  CERTIFICATE
  PORTFOLIO
  ASSESSMENT
  MANUAL_REVIEW
  PARTNER_ISSUED
}

enum CandidateSkillVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum CandidatePartnerMarkerType {
  UNIVERSITY_VERIFIED
  BOOTCAMP_VERIFIED
  TRAINING_VERIFIED
  SCHOLARSHIP_ALUMNI
  SCHOLARSHIP_FELLOW
  PARTNER_RECOMMENDED
}

enum CandidatePartnerMarkerStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum VerificationArtifactType {
  BUSINESS_REGISTRATION
  DOMAIN_OWNERSHIP
  LINKEDIN_COMPANY
  IDENTITY_DOCUMENT
  CERTIFICATION
  EMPLOYMENT_PROOF
}

enum VerificationArtifactStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum TrustEntityType {
  USER
  EMPLOYER
  CANDIDATE
  JOB
  APPLICATION
  MESSAGE
  REPORT
}

enum TrustRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TrustCaseStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum ModerationActionType {
  NOTE
  APPROVE
  REJECT
  HOLD
  LIMIT
  SUSPEND
  REINSTATE
  ESCALATE
}

enum AbuseReportReason {
  SCAM
  FAKE_JOB
  IMPERSONATION
  SPAM
  OFF_PLATFORM_CONTACT
  ADVANCE_FEE_REQUEST
  HARASSMENT
  FAKE_PROFILE
  MISLEADING_SALARY
  OTHER
}

enum AbuseReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
}

enum AccountRestrictionStatus {
  ACTIVE
  LIMITED
  SUSPENDED
}

enum PhoneVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

// ──────────────── OAuth & Email Verification ────────────────

enum OAuthProvider {
  GOOGLE
  APPLE
}

model OAuthAccount {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       OAuthProvider
  providerUserId String
  email          String?       @db.VarChar(255)
  displayName    String?       @db.VarChar(200)
  avatarUrl      String?       @db.VarChar(500)
  accessToken    String?       @db.Text
  refreshToken   String?       @db.Text
  tokenExpiresAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([provider, email])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

// ──────────────── Regional Pricing ────────────────

enum BillingRegion {
  AFRICA
  EUROPE
  ROW // Rest of World
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum RegionChangeSource {
  USER_SELECTED
  STRIPE_PAYMENT
  IP_GEOLOCATION
  ADMIN_OVERRIDE
}

enum BillingEventOutcome {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  RECONCILED
}

enum BillingDiscrepancyType {
  WEBHOOK_FAILURE
  SUBSCRIPTION_STATE_MISMATCH
  PLAN_MISMATCH
  UNPAID_BUT_ENTITLED
  PAID_BUT_NOT_ENTITLED
  PENDING_REFUND
  REGION_MISMATCH
  STALE_ENTITLEMENT
  PAYMENT_FAILURE
}

enum BillingDiscrepancyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum BillingSupportActionType {
  NOTE
  RESYNC_ENTITLEMENTS
  RESEND_RECEIPT
  REFUND_REVIEW
  CANCEL_SUBSCRIPTION
  UPGRADE_DOWNGRADE_CORRECTION
  GRANDFATHER_OVERRIDE
}

enum BillingReconciliationStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model RegionalPrice {
  id            String           @id @default(uuid())
  plan          SubscriptionPlan
  region        BillingRegion
  interval      BillingInterval
  currency      String           @db.VarChar(3) // ISO 4217
  amount        Int // minor units (cents, kobo, etc.)
  stripePriceId String?          @db.VarChar(255) // Stripe Price object ID
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([plan, region, interval, currency])
  @@index([plan, region, isActive])
  @@index([stripePriceId])
}

model PlanEntitlement {
  id                    String           @id @default(uuid())
  plan                  SubscriptionPlan @unique
  applicationsPerMonth  Int? // null = unlimited
  aiResumeReviews       Int?
  aiJobMatches          Int?
  aiApplyPacks          Int?
  savedSearches         Int?
  jobAlerts             Boolean          @default(true)
  prioritySupport       Boolean          @default(false)
  skillsAssessments     Boolean          @default(false)
  chatAccess            Boolean          @default(false)
  autopilot             Boolean          @default(false)
  jobPostsPerMonth      Int? // employer plans
  talentSearch          Boolean          @default(false) // employer
  analytics             Boolean          @default(false) // employer
  apiAccess             Boolean          @default(false) // employer premium
  atsIntegrations       Int? // employer integrations quota
  videoMockInterviews   Int? // monthly seat quota
  pipelineExports       Boolean          @default(false)
  brandedCareerPage     Boolean          @default(false)
  advancedFunnelMetrics Boolean          @default(false)
  customFeatures        Json? // extensible
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model UserBillingProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  country         String?            @db.VarChar(2) // ISO 3166-1 alpha-2
  region          BillingRegion      @default(ROW)
  currency        String             @default("USD") @db.VarChar(3)
  pricingVersion  Int                @default(1)
  isGrandfathered Boolean            @default(false)
  grandfatheredAt DateTime?
  regionSource    RegionChangeSource @default(USER_SELECTED)
  taxIdType       String?            @db.VarChar(50) // e.g. eu_vat
  taxIdValue      String?            @db.VarChar(100)
  stripeCountry   String?            @db.VarChar(2) // from payment method
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  regionChanges BillingRegionAudit[]

  @@index([userId])
  @@index([region])
}

model BillingRegionAudit {
  id              String             @id @default(uuid())
  profileId       String
  profile         UserBillingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  previousRegion  BillingRegion?
  newRegion       BillingRegion
  previousCountry String?            @db.VarChar(2)
  newCountry      String?            @db.VarChar(2)
  source          RegionChangeSource
  ipAddress       String?            @db.VarChar(45)
  metadata        Json?
  createdAt       DateTime           @default(now())

  @@index([profileId, createdAt(sort: Desc)])
}

model RegionConfig {
  id              String        @id @default(uuid())
  region          BillingRegion @unique
  defaultCurrency String        @db.VarChar(3)
  currencies      String[] // supported currencies for this region
  countries       String[] // ISO 3166-1 alpha-2 codes
  taxBehavior     String        @default("unspecified") @db.VarChar(20) // inclusive, exclusive, unspecified
  taxLabel        String?       @db.VarChar(50) // e.g. "VAT", "GST"
  isActive        Boolean       @default(true)
  metadata        Json? // e.g. { vatRates: { standard: 20 } }
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ──────────────── Existing Models ────────────────

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  password                 String                   @default("")
  name                     String
  role                     Role
  preferredLocale          SupportedLocale          @default(EN)
  emailVerified            Boolean                  @default(false)
  emailVerifiedAt          DateTime?
  avatarUrl                String?                  @db.VarChar(500)
  accountRestrictionStatus AccountRestrictionStatus @default(ACTIVE)
  accountRestrictionReason String?                  @db.VarChar(160)
  accountRestrictedAt      DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  employer                      Employer?
  applications                  Application[]
  adminReviews                  AdminReview[]              @relation("AdminReviewer")
  candidateProfile              CandidateProfile?
  subscription                  Subscription?
  notifications                 Notification[]
  threadParticipants            ThreadParticipant[]
  sentMessages                  Message[]                  @relation("MessageSender")
  aiRuns                        AiRun[]
  savedSearches                 SavedSearch[]
  jobAlerts                     JobAlert[]
  companyReviews                CompanyReview[]
  skillAssessments              SkillAssessment[]
  assessmentInvites             AssessmentInvite[]
  passwordResets                PasswordResetToken[]
  interviewExperiences          InterviewExperience[]
  salaryReports                 SalaryReport[]
  immigrationProcesses          ImmigrationProcess[]
  referralsMade                 Referral[]                 @relation("ReferralsMade")
  referralsReceived             Referral[]                 @relation("ReferralsReceived")
  calendarEvents                CalendarEvent[]
  chatConsent                   ChatConsent?
  chatConversations             ChatConversation[]
  billingProfile                UserBillingProfile?
  oauthAccounts                 OAuthAccount[]
  emailVerificationTokens       EmailVerificationToken[]
  notificationPreferences       NotificationPreference?
  pushSubscriptions             PushSubscription[]
  analyticsEvents               AnalyticsEvent[]
  mockInterviewSessions         MockInterviewSession[]
  socialProfile                 SocialProfile?
  socialConnectionsSent         SocialConnection[]         @relation("SocialConnectionRequester")
  socialConnectionsRecv         SocialConnection[]         @relation("SocialConnectionRecipient")
  salaryNegotiations            SalaryNegotiationSession[]
  botSubscriptions              BotSubscription[]
  employerAiTasksCreated        EmployerAiTask[]           @relation("EmployerAiTaskCreator")
  employerAiTasksReviewed       EmployerAiTask[]           @relation("EmployerAiTaskReviewer")
  billingEvents                 BillingEventAudit[]
  billingDiscrepancies          BillingDiscrepancy[]
  billingEntitlementState       BillingEntitlementState?
  candidateTrustProfile         CandidateTrustProfile?
  billingSupportActions         BillingSupportAction[]     @relation("BillingSupportTarget")
  billingSupportActionsTaken    BillingSupportAction[]     @relation("BillingSupportActor")
  verificationArtifacts         VerificationArtifact[]     @relation("UserVerificationArtifacts")
  reviewedVerificationArtifacts VerificationArtifact[]     @relation("VerificationArtifactReviewer")
  verifiedSkills                CandidateVerifiedSkill[]   @relation("CandidateVerifiedSkillOwner")
  reviewedCandidateSkills       CandidateVerifiedSkill[]   @relation("CandidateVerifiedSkillReviewer")
  partnerMarkers                CandidatePartnerMarker[]   @relation("CandidatePartnerMarkerOwner")
  reviewedPartnerMarkers        CandidatePartnerMarker[]   @relation("CandidatePartnerMarkerReviewer")
  trustRiskEvents               TrustRiskEvent[]
  abuseReportsFiled             AbuseReport[]              @relation("AbuseReportReporter")
  abuseReportsAgainst           AbuseReport[]              @relation("AbuseReportTargetUser")
  abuseReportsAssigned          AbuseReport[]              @relation("AbuseReportAssignee")
  trustCasesAssigned            TrustCase[]                @relation("TrustCaseAssignee")
  trustCaseActions              TrustCaseAction[]          @relation("TrustCaseActionActor")

  @@index([role])
  @@index([createdAt])
  @@index([accountRestrictionStatus])
}

model Employer {
  id          String   @id @default(uuid())
  companyName String
  website     String?
  location    String
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  jobs                  Job[]
  atsConnections        ATSConnection[]
  aiTasks               EmployerAiTask[]
  onboardingState       EmployerOnboardingState?
  trustProfile          EmployerTrustProfile?
  verificationArtifacts VerificationArtifact[]   @relation("EmployerVerificationArtifacts")
  trustRiskEvents       TrustRiskEvent[]
  abuseReports          AbuseReport[]
}

model EmployerOnboardingState {
  id               String            @id @default(uuid())
  employerId       String            @unique
  employer         Employer          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  currentStep      String            @default("company_setup") @db.VarChar(80)
  teamMemberEmails String[]
  candidateFilters Json?
  selectedPlan     SubscriptionPlan?
  helperState      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([currentStep, updatedAt(sort: Desc)])
}

model Job {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String
  location    String
  type        String
  seniority   String
  salaryMin   Int?
  salaryMax   Int?
  currency    String?
  tags        String[]
  status      JobStatus
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Phase A — AfriTalent differentiators
  visaSponsorship            VisaSponsorshipStatus @default(UNKNOWN)
  relocationAssistance       Boolean               @default(false)
  eligibleCountries          String[]
  jobSource                  JobSource             @default(EMPLOYER_POSTED)
  sourceUrl                  String?
  sourceId                   String? // external ATS/job board ID (for dedup)
  sourceName                 String? // company name for aggregated jobs
  applicationUrl             String?
  sourceFingerprint          String?               @db.VarChar(80)
  sourceLineage              Json?
  sourceFirstSeenAt          DateTime?
  sourceLastSeenAt           DateTime?
  freshnessScore             Int                   @default(0)
  qualityScore               Int                   @default(0)
  applicationLikelihoodScore Int                   @default(0)
  freshnessSignals           Json?
  qualitySignals             Json?
  staleAt                    DateTime?

  // Job expiry tracking
  expiresAt        DateTime? // when the listing expires (from source or heuristic)
  lastCheckedAt    DateTime? // last time we verified the listing is still live
  isExpired        Boolean        @default(false)
  riskScore        Int            @default(0)
  riskLevel        TrustRiskLevel @default(LOW)
  trustFlags       Json?
  qualityCheckedAt DateTime?

  // Nullable for aggregated jobs (no Employer profile in DB)
  employerId String?
  employer   Employer? @relation(fields: [employerId], references: [id])

  applications              Application[]
  adminReviews              AdminReview[]              @relation("JobReviews")
  threads                   MessageThread[]
  jobAlerts                 JobAlert[]
  assessmentInvites         AssessmentInvite[]
  salaryNegotiationSessions SalaryNegotiationSession[]
  trustRiskEvents           TrustRiskEvent[]
  abuseReports              AbuseReport[]
  trustCases                TrustCase[]

  @@index([status])
  @@index([status, publishedAt(sort: Desc)])
  @@index([employerId])
  @@index([location])
  @@index([type])
  @@index([seniority])
  @@index([visaSponsorship])
  @@index([jobSource])
  @@index([sourceId])
  @@index([sourceFingerprint])
  @@index([isExpired, status])
  @@index([expiresAt])
  @@index([staleAt])
  @@index([sourceLastSeenAt])
  @@index([freshnessScore, qualityScore])
  @@index([riskLevel, riskScore])
}

model Application {
  id          String            @id @default(uuid())
  status      ApplicationStatus
  cvUrl       String?
  coverLetter String?
  notes       String?
  riskScore   Int               @default(0)
  riskLevel   TrustRiskLevel    @default(LOW)
  trustFlags  Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  candidateId String
  candidate   User   @relation(fields: [candidateId], references: [id])

  adminReviews    AdminReview[]    @relation("ApplicationReviews")
  thread          MessageThread?
  trustRiskEvents TrustRiskEvent[]
  abuseReports    AbuseReport[]
  trustCases      TrustCase[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([riskLevel, riskScore])
}

model Resource {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  adminReviews AdminReview[] @relation("ResourceReviews")

  @@index([published])
  @@index([published, publishedAt(sort: Desc)])
  @@index([category])
}

model AdminReview {
  id        String       @id @default(uuid())
  status    ReviewStatus
  notes     String?
  createdAt DateTime     @default(now())

  reviewerId String
  reviewer   User   @relation("AdminReviewer", fields: [reviewerId], references: [id])

  targetType ReviewTargetType

  targetJobId String?
  targetJob   Job?    @relation("JobReviews", fields: [targetJobId], references: [id])

  targetApplicationId String?
  targetApplication   Application? @relation("ApplicationReviews", fields: [targetApplicationId], references: [id])

  targetResourceId String?
  targetResource   Resource? @relation("ResourceReviews", fields: [targetResourceId], references: [id])

  @@index([reviewerId])
  @@index([targetType])
  @@index([createdAt(sort: Desc)])
}

// ──────────────── Phase A New Models ────────────────

model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline            String?  @db.VarChar(200)
  bio                 String?  @db.Text
  skills              String[]
  targetRoles         String[]
  targetCountries     String[]
  yearsExperience     Int?
  visaStatus          String?  @db.VarChar(100)
  linkedinUrl         String?  @db.VarChar(500)
  githubUrl           String?  @db.VarChar(500)
  portfolioUrl        String?  @db.VarChar(500)
  workHistory         Json?
  educationHistory    Json?
  certifications      Json?
  openToWork          Boolean  @default(false)
  profileCompleteness Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  resumes Resume[]

  @@index([userId])
  @@index([openToWork])
  @@index([skills])
}

model EmployerTrustProfile {
  id                           String                    @id @default(uuid())
  employerId                   String                    @unique
  employer                     Employer                  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  verificationLevel            EmployerVerificationLevel @default(UNVERIFIED)
  authenticityScore            Int                       @default(0)
  riskScore                    Int                       @default(0)
  riskLevel                    TrustRiskLevel            @default(LOW)
  postingEligibility           Boolean                   @default(false)
  requiresEnhancedVerification Boolean                   @default(false)
  verifiedDomain               String?                   @db.VarChar(255)
  websiteMatchesEmail          Boolean                   @default(false)
  throwawayDomainDetected      Boolean                   @default(false)
  linkedInCompanyUrl           String?                   @db.VarChar(500)
  domainVerifiedAt             DateTime?
  businessDocVerifiedAt        DateTime?
  manualApprovedAt             DateTime?
  premiumTrustedAt             DateTime?
  suspiciousSignals            Json?
  internalNotes                String?                   @db.Text
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  trustCases TrustCase[]

  @@index([verificationLevel])
  @@index([riskLevel, riskScore])
  @@index([postingEligibility])
}

model CandidateTrustProfile {
  id                    String                     @id @default(uuid())
  userId                String                     @unique
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationLevel     CandidateVerificationLevel @default(UNVERIFIED)
  authenticityScore     Int                        @default(0)
  riskScore             Int                        @default(0)
  riskLevel             TrustRiskLevel             @default(LOW)
  phoneNumber           String?                    @db.VarChar(30)
  phoneVerifiedAt       DateTime?
  identityVerifiedAt    DateTime?
  skillsVerifiedAt      DateTime?
  employmentVerifiedAt  DateTime?
  linkedinVerified      Boolean                    @default(false)
  githubVerified        Boolean                    @default(false)
  portfolioVerified     Boolean                    @default(false)
  premiumFilterEligible Boolean                    @default(false)
  verifiedSkillCount    Int                        @default(0)
  partnerSignalCount    Int                        @default(0)
  assessmentBacked      Boolean                    @default(false)
  fullyCompletedProfile Boolean                    @default(false)
  explainabilitySignals Json?
  suspiciousSignals     Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  phoneChallenges PhoneVerificationChallenge[]
  trustCases      TrustCase[]

  @@index([verificationLevel])
  @@index([riskLevel, riskScore])
  @@index([premiumFilterEligible])
}

model PhoneVerificationChallenge {
  id                      String                  @id @default(uuid())
  candidateTrustProfileId String
  candidateTrustProfile   CandidateTrustProfile   @relation(fields: [candidateTrustProfileId], references: [id], onDelete: Cascade)
  phoneNumber             String                  @db.VarChar(30)
  otpHash                 String                  @db.VarChar(128)
  expiresAt               DateTime
  attempts                Int                     @default(0)
  verifiedAt              DateTime?
  status                  PhoneVerificationStatus @default(PENDING)
  createdAt               DateTime                @default(now())

  @@index([candidateTrustProfileId, createdAt(sort: Desc)])
  @@index([phoneNumber, status])
}

model VerificationArtifact {
  id             String                     @id @default(uuid())
  type           VerificationArtifactType
  status         VerificationArtifactStatus @default(PENDING)
  userId         String?
