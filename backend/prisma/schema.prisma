  employmentStatus  String?  @db.VarChar(50) // full-time, contract, intern
  jobTitle          String?  @db.VarChar(100)
  yearsAtCompany    Int?
  isVerified        Boolean  @default(false)
  isApproved        Boolean  @default(false)
  helpfulCount      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, isApproved])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model CompanyRatingAggregate {
  id                String   @id @default(uuid())
  companyId         String   @unique
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  totalReviews      Int      @default(0)
  averageOverall    Float?
  averageCulture    Float?
  averageSalary     Float?
  averageWorkLife   Float?
  averageManagement Float?
  averageGrowth     Float?
  recommendationPct Float? // % who would recommend
  updatedAt         DateTime @updatedAt
}

// ──────────────── Skills Assessment Integration ────────────────

enum AssessmentProvider {
  INTERNAL
  TESTGORILLA
  HACKERRANK
  CODILITY
  CUSTOM
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  FAILED
}

model SkillAssessment {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName   String             @db.VarChar(100)
  provider    AssessmentProvider
  externalId  String?            @db.VarChar(255)
  status      AssessmentStatus   @default(PENDING)
  score       Int? // 0-100
  percentile  Int? // 0-100
  level       String?            @db.VarChar(50) // beginner, intermediate, advanced, expert
  resultUrl   String?            @db.VarChar(500)
  metadata    Json?
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())

  verifiedSkills CandidateVerifiedSkill[]

  @@index([userId, skillName])
  @@index([status])
}

model AssessmentInvite {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String?
  provider      AssessmentProvider
  assessmentUrl String             @db.VarChar(500)
  expiresAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([userId])
  @@index([jobId])
}

// ──────────────── Interview Experiences ────────────────

model InterviewExperience {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle      String   @db.VarChar(200)
  difficulty    String   @db.VarChar(20) // easy, medium, hard
  outcome       String   @db.VarChar(20) // offered, rejected, no_response, withdrew
  interviewType String   @db.VarChar(50) // phone, video, onsite, take_home, panel
  process       String   @db.Text
  questions     String[] // array of interview questions
  tips          String?  @db.Text
  duration      String?  @db.VarChar(50) // e.g., "2 weeks", "1 month"
  isApproved    Boolean  @default(false)
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([companyId, isApproved])
  @@index([userId])
  @@index([jobTitle])
}

// ──────────────── Salary Reports ────────────────

model SalaryReport {
  id              String   @id @default(uuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle        String   @db.VarChar(200)
  location        String   @db.VarChar(200)
  country         String   @db.VarChar(100)
  salaryCurrency  String   @default("USD") @db.VarChar(10)
  salaryAmount    Int
  salaryPeriod    String   @default("yearly") @db.VarChar(20) // yearly, monthly
  yearsExperience Int?
  employmentType  String?  @db.VarChar(50) // full-time, contract, part-time
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([jobTitle, country])
  @@index([companyId])
  @@index([userId])
  @@index([country])
}

// ──────────────── Immigration Process Tracker ────────────────

enum ImmigrationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  DENIED
  EXPIRED
}

model ImmigrationProcess {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  visaType        String            @db.VarChar(100)
  targetCountry   String            @db.VarChar(100)
  status          ImmigrationStatus @default(NOT_STARTED)
  startDate       DateTime?
  expectedEndDate DateTime?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  steps ImmigrationStep[]

  @@index([userId])
  @@index([status])
}

model ImmigrationStep {
  id          String             @id @default(uuid())
  processId   String
  process     ImmigrationProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  name        String             @db.VarChar(200)
  description String?            @db.Text
  status      ImmigrationStatus  @default(NOT_STARTED)
  dueDate     DateTime?
  completedAt DateTime?
  documents   String[]
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([processId])
}

// ──────────────── Referrals ────────────────

enum ReferralStatus {
  PENDING
  ACCEPTED
  HIRED
  EXPIRED
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String
  referrer     User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeEmail String         @db.VarChar(255)
  refereeId    String?
  referee      User?          @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: SetNull)
  jobId        String?
  companyName  String?        @db.VarChar(200)
  message      String?        @db.Text
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([referrerId])
  @@index([refereeEmail])
  @@index([refereeId])
}

// ──────────────── Learning Resources ────────────────

model LearningResource {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(300)
  description   String?  @db.Text
  url           String   @db.VarChar(500)
  provider      String   @db.VarChar(100) // Coursera, Udemy, YouTube, etc.
  category      String   @db.VarChar(100) // programming, design, data-science, etc.
  skills        String[]
  difficulty    String   @db.VarChar(20) // beginner, intermediate, advanced
  durationHours Float?
  isFree        Boolean  @default(false)
  imageUrl      String?  @db.VarChar(500)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([skills])
  @@index([featured])
}

model LearningFeedback {
  id               String                 @id @default(uuid())
  areaSlug         String                 @db.VarChar(120)
  lessonTitle      String?                @db.VarChar(200)
  firstName        String                 @db.VarChar(80)
  lastName         String                 @db.VarChar(80)
  userId           String?
  user             User?                  @relation("LearningFeedbackSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  rating           Int
  comment          String                 @db.Text
  attachPhoto      Boolean                @default(false)
  avatarUrlSnapshot String?               @db.VarChar(500)
  displayName      String                 @db.VarChar(180)
  status           LearningFeedbackStatus @default(PENDING)
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?                  @relation("LearningFeedbackModerator", fields: [approvedById], references: [id], onDelete: SetNull)
  moderationNotes  String?                @db.Text
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([areaSlug, status])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// ──────────────── Calendar Events / Interview Scheduling ────────────────

enum CalendarEventType {
  INTERVIEW
  FOLLOW_UP
  DEADLINE
  CUSTOM
}

model CalendarEvent {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String            @db.VarChar(300)
  description     String?           @db.Text
  eventType       CalendarEventType @default(CUSTOM)
  startTime       DateTime
  endTime         DateTime?
  location        String?           @db.VarChar(300)
  meetingUrl      String?           @db.VarChar(500)
  jobId           String?
  applicationId   String?
  reminderMinutes Int?              @default(30)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, startTime])
  @@index([userId, eventType])
}

// ──────────────── Job Views / Profile Analytics ────────────────

model ProfileView {
  id         String   @id @default(uuid())
  profileId  String
  viewerId   String?
  viewerRole String?  @db.VarChar(20)
  createdAt  DateTime @default(now())

  @@index([profileId, createdAt(sort: Desc)])
  @@index([viewerId])
}

// ──────────────── Password Reset ────────────────

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

// ──────────────── AI Chat Assistant ────────────────

enum ChatConsentType {
  PRIVACY_NOTICE
  TERMS_OF_USE
  DATA_STORAGE
}

model ChatConsent {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  privacyNotice Boolean   @default(false)
  termsOfUse    Boolean   @default(false)
  dataStorage   Boolean   @default(false)
  consentedAt   DateTime?
  revokedAt     DateTime?
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  @db.VarChar(200)
  summary   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, isActive])
  @@index([userId, updatedAt(sort: Desc)])
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String           @db.Text
  metadata       Json?
  tokenCount     Int?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// ──────────────── Semantic Retrieval Foundation ────────────────

model SemanticDocument {
  id                  String   @id @default(uuid())
  namespace           String   @db.VarChar(100)
  sourceType          String   @db.VarChar(100)
  sourceId            String   @db.VarChar(191)
  title               String?  @db.VarChar(300)
  content             String   @db.Text
  metadata            Json?
  embedding           Float[]
  embeddingDimensions Int
  embeddingProvider   String   @db.VarChar(50)
  embeddingModel      String   @db.VarChar(100)
  checksum            String   @db.VarChar(64)
  lastIndexedAt       DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([namespace, sourceType, sourceId])
  @@index([namespace, sourceType])
  @@index([namespace, updatedAt(sort: Desc)])
}

// ──────────────── Phase 2 New Models — Database Agent ────────────────

model AtsReport {
  id               String  @id @default(cuid())
  resumeId         String
  jobDescriptionId String?

  // Scores
  score Float @default(0) // 0.0 to 1.0

  // Missing elements
  missingKeywords String[] @default([])
  presentKeywords String[] @default([])

  // Formatting issues
  formatting  Json? // { "pageBreaks": true, "columns": false, ... }
  suggestions String[] @default([])

  // Tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  resume UserResume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([createdAt])
}

model CoverLetterVersion {
  id          String @id @default(cuid())
  candidateId String
  jobId       String

  // Content
  content String  @db.Text
  tone    String? // "formal" | "conversational" | "executive"

  // Tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([createdAt])
}

model AutoApplyBatch {
  id          String @id @default(cuid())
  candidateId String

  // Batch metadata
  jobFilters   Json? // Filter criteria used (visaSponsorship, salaryMin, etc.)
  jobsTargeted Int   @default(0)

  // Progress tracking
  jobsApplied Int @default(0)
  jobsFailed  Int @default(0)
  creditsUsed Int @default(0)

  // Status
  status String @default("queued") // "queued" | "in_progress" | "completed" | "failed"

  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
  @@index([createdAt])
}

model SalaryBenchmark {
  id String @id @default(cuid())

  // Classification
  role     String // "Software Engineer", "Data Analyst", etc.
  level    String // "entry" | "mid" | "senior" | "lead"
  country  String // "NG" | "KE" | "ZA" | "EG" | "GH" etc.
  currency String @default("USD")

  // Data
  salaryMin    Float
  salaryMedian Float
  salaryMax    Float

  // Metadata
  sampleSize  Int      @default(0)
  lastUpdated DateTime @default(now())
  source      String? // "crowdsourced" | "glassdoor" | "payscale" etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, level, country, currency])
  @@index([country])
  @@index([role])
}

model CareerGapSession {
  id          String @id @default(cuid())
  candidateId String

  // Gap details
  startDate DateTime
  endDate   DateTime
  reason    String?  @db.Text // User-provided reason

  // Analysis
  analysis      String   @db.Text // AI-generated analysis
  reframing     String   @db.Text // How to frame it positively
  talkingPoints String[] @default([])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([createdAt])
}

// ──────────────── Admin Control Plane ────────────────

model AdminRole {
  id          String            @id @default(uuid())
  adminId     String            @unique
  admin       User              @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title       String            @db.VarChar(100)
  description String?           @db.VarChar(500)
  permissions AdminPermission[]
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  auditLogs AuditLog[] @relation("AuditLogAdmin")

  @@index([isActive])
}

model AuditLog {
  id           String      @id @default(uuid())
  adminId      String?
  admin        AdminRole?  @relation("AuditLogAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  action       AdminAction
  targetType   String      @db.VarChar(50)
  targetId     String?
  targetName   String?     @db.VarChar(200)
  resourceType String?     @db.VarChar(50)
  resourceId   String?
  changes      Json?
  reason       String?     @db.VarChar(500)
  metadata     Json?
  ipAddress    String?     @db.VarChar(50)
  userAgent    String?     @db.VarChar(500)
  status       String      @default("SUCCESS") @db.VarChar(20)
  errorDetails String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetId])
  @@index([createdAt(sort: Desc)])
}

model PlatformAlert {
  id              String        @id @default(uuid())
  title           String        @db.VarChar(200)
  description     String        @db.Text
  severity        AlertSeverity
  status          AlertStatus   @default(ACTIVE)
  category        String        @db.VarChar(50)
  metrics         Json?
  affectedUsers   Int?
  affectedJobs    Int?
  affectedApps    Int?
  firstOccurredAt DateTime      @default(now())
  lastOccurredAt  DateTime      @updatedAt
  resolvedAt      DateTime?
  resolution      String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([severity, status, createdAt(sort: Desc)])
  @@index([category, status])
  @@index([status, updatedAt(sort: Desc)])
}

model BulkOperation {
  id            String              @id @default(uuid())
  operationType BulkOperationType
  status        BulkOperationStatus @default(QUEUED)
  initiatedBy   String?             @db.VarChar(100)
  query         Json?
  filters       Json?
  targetCount   Int                 @default(0)
  successCount  Int                 @default(0)
  failureCount  Int                 @default(0)
  results       Json?
  errorLog      String?             @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([operationType, createdAt(sort: Desc)])
}

// ──────────────── SMS / Phone Verification ────────────────

enum UserPhoneOtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  CONSUMED
}

enum SmsDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model UserPhoneOtp {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String             @db.VarChar(30)
  otpHash     String             @db.VarChar(128)
  expiresAt   DateTime
  attempts    Int                @default(0)
  status      UserPhoneOtpStatus @default(PENDING)
  consumedAt  DateTime?
  ipAddress   String?            @db.VarChar(45)
  userAgent   String?            @db.VarChar(500)
  createdAt   DateTime           @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([phoneNumber, status])
}

model SmsDeliveryLog {
  id            String            @id @default(uuid())
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  phoneNumber   String            @db.VarChar(30)
  provider      String            @default("africastalking") @db.VarChar(40)
  providerMsgId String?           @db.VarChar(120)
  template      String            @db.VarChar(80)
  status        SmsDeliveryStatus @default(QUEUED)
  errorCode     String?           @db.VarChar(80)
  errorMessage  String?           @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([phoneNumber, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([template, createdAt(sort: Desc)])
}
