}

model CandidateLifecycleState {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekWindowStartedAt       DateTime?
  notificationsThisWeek     Int       @default(0)
  lastNotificationAt        DateTime?
  lastDigestAt              DateTime?
  lastApplicationReminderAt DateTime?
  lastProfileNudgeAt        DateTime?
  lastVerificationNudgeAt   DateTime?
  lastVisaAlertAt           DateTime?
  lastSalaryInsightAt       DateTime?
  lastInterviewPrepAt       DateTime?
  lastDigestJobCount        Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  events CandidateLifecycleEvent[]

  @@index([weekWindowStartedAt])
  @@index([lastNotificationAt])
}

model CandidateLifecycleEvent {
  id               String                        @id @default(uuid())
  userId           String
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifecycleStateId String?
  lifecycleState   CandidateLifecycleState?      @relation(fields: [lifecycleStateId], references: [id], onDelete: SetNull)
