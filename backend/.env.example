# ============================================
# AfriTalent Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Local: postgresql://postgres:postgres@localhost:5432/afritalent
# Staging: Use managed PostgreSQL URL (Railway/Supabase)
# Production: Use managed PostgreSQL URL with SSL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/afritalent"

# --------------------------------------------
# Authentication
# --------------------------------------------
# CRITICAL: Generate a strong secret for production
# Use: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT expiration time (default: 7d)
JWT_EXPIRES_IN="7d"

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Local: http://localhost:3000
# Staging: https://staging.afritalent.example.com
# Production: https://afritalent.example.com
FRONTEND_URL="http://localhost:3000"

# Optional regex for additional allowed browser origins (useful for temporary
# App Runner service URLs before custom domains are live)
ALLOWED_ORIGIN_REGEX=""

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=4000
NODE_ENV="development"

# API documentation endpoint
# In production, docs are disabled unless this is set to true.
ENABLE_API_DOCS="false"

# --------------------------------------------
# Rate Limiting (optional, defaults shown)
# --------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# Logging
# --------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# --------------------------------------------
# Error Tracking (optional)
# --------------------------------------------
# Sentry DSN for backend/server-side error capture
SENTRY_DSN=""

# --------------------------------------------
# OAuth Providers (optional, enables social login)
# --------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple: https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --------------------------------------------
# Email (SES for production)
# --------------------------------------------
SES_FROM_EMAIL="noreply@afritalent.com"

# --------------------------------------------
# Web Push Notifications (optional)
# --------------------------------------------
# Generate keys with:
# npx web-push generate-vapid-keys
WEB_PUSH_VAPID_SUBJECT="mailto:security@afritalent.com"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# --------------------------------------------
# Redis (optional but recommended for cache + token revocation)
# --------------------------------------------
# Example: redis://localhost:6379
REDIS_URL=""

# --------------------------------------------
# Aggregator Source Tokens (optional)
# --------------------------------------------
# Comma-separated board/site identifiers
GREENHOUSE_BOARD_TOKENS=""
LEVER_SITE_TOKENS=""
# WORKABLE_COMPANY_TOKENS format:
#   accountSlug
#   accountSlug:apiToken
# Multiple entries are comma-separated.
WORKABLE_COMPANY_TOKENS=""

# --------------------------------------------
# ATS Integration Security
# --------------------------------------------
# 32+ char secret used to encrypt ATS access/refresh tokens at rest.
ATS_TOKEN_ENCRYPTION_KEY=""

# --------------------------------------------
# Mock Interview Controls
# --------------------------------------------
# Default retention window (days) for interview media/transcript artifacts.
MOCK_INTERVIEW_RETENTION_DAYS=30

# --------------------------------------------
# AI Mock Mode
# --------------------------------------------
# Set to 1 for testing without Claude API
MOCK_AI=0

# --------------------------------------------
# AI Models
# --------------------------------------------
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_QUALITY_MODEL=claude-sonnet-4-6

# --------------------------------------------
# Orchestrator Limits
# --------------------------------------------
ORCHESTRATOR_TOKEN_BUDGET_MAX=120000

# --------------------------------------------
# AI Controls
# --------------------------------------------
AI_DISABLED=0
DAILY_APPLY_PACK_LIMIT=5
DAILY_JOB_MATCH_LIMIT=20
DAILY_RESUME_REVIEW_LIMIT=10
