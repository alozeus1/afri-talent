# ============================================
# AfriTalent Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Local: postgresql://postgres:postgres@localhost:5432/afritalent
# Staging: Use managed PostgreSQL URL (Railway/Supabase)
# Production: Use managed PostgreSQL URL with SSL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/afritalent"

# --------------------------------------------
# Authentication
# --------------------------------------------
# CRITICAL: Generate a strong secret for production
# Use: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# JWT expiration time (default: 7d)
JWT_EXPIRES_IN="7d"

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Local: http://localhost:3000
# Staging: https://staging.afritalent.example.com
# Production: https://afritalent.example.com
FRONTEND_URL="http://localhost:3000"

# Optional regex for additional allowed browser origins (useful for temporary
# App Runner service URLs before custom domains are live)
ALLOWED_ORIGIN_REGEX=""

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=4000
NODE_ENV="development"

# API documentation endpoint
# In production, docs are disabled unless this is set to true.
ENABLE_API_DOCS="false"

# --------------------------------------------
# Rate Limiting (optional, defaults shown)
# --------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# --------------------------------------------
# Logging
# --------------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL="info"

# --------------------------------------------
# Error Tracking (optional)
# --------------------------------------------
# Sentry DSN for backend/server-side error capture
SENTRY_DSN=""

# --------------------------------------------
# OAuth Providers (optional, enables social login)
# --------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple: https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --------------------------------------------
# Email (SES for production)
# --------------------------------------------
SES_FROM_EMAIL="noreply@afritalent.com"

# --------------------------------------------
# Web Push Notifications (optional)
# --------------------------------------------
# Generate keys with:
# npx web-push generate-vapid-keys
WEB_PUSH_VAPID_SUBJECT="mailto:security@afritalent.com"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# --------------------------------------------
# Redis (optional but recommended for cache + token revocation)
# --------------------------------------------
# Example: redis://localhost:6379
REDIS_URL=""

# --------------------------------------------
# Aggregator Source Tokens (optional)
# --------------------------------------------
# Adzuna multi-region search API
ADZUNA_APP_ID=""
ADZUNA_API_KEY=""

# Apify task runner for stronger scraping coverage.
# APIFY_JOB_TASKS_JSON example:
# [
#   {
#     "taskId":"username~remoteok-task",
#     "label":"RemoteOK engineering mirror",
#     "defaultInput":{"country":"ng"},
#     "overrideKeywordsField":"query",
#     "overrideLimitField":"maxItems",
#     "regionHint":"REMOTE_GLOBAL",
#     "locationTypeHint":"remote"
#   }
# ]
APIFY_TOKEN=""
APIFY_JOB_TASKS_JSON=""

# Comma-separated board/site identifiers
# AfriTalent also ships with a default curated Greenhouse/Lever catalog unless disabled below.
# Default Lever coverage currently includes: plaid, spreetail, yubico,
# pointclickcare, levelai, enter-rcm-llc
GREENHOUSE_BOARD_TOKENS=""
LEVER_SITE_TOKENS=""
# WORKABLE_COMPANY_TOKENS format:
#   accountSlug
#   accountSlug:apiToken
# Multiple entries are comma-separated.
# Public Workable endpoints are commonly locked down; authenticated account tokens
# are recommended for reliable production coverage.
WORKABLE_COMPANY_TOKENS=""
# Merge built-in default company board catalogs with the configured values above.
# Set to 0 only if you want to fully control board coverage via secrets.
AGGREGATOR_INCLUDE_DEFAULT_BOARD_CATALOG="1"
# By default, configured API-backed sources suppress fragile scraper sources.
# Set to 1 only if you explicitly want the public scraping adapters included too.
AGGREGATOR_INCLUDE_SCRAPED_SOURCES="0"
# Scheduled sync tuning. Defaults favor broader market coverage while freshness
# labels still make stale jobs obvious in the UI.
AGGREGATOR_MAX_JOBS="500"
AGGREGATOR_POSTED_DAYS="21"

# --------------------------------------------
# Semantic Matching / Retrieval
# --------------------------------------------
# hash = local fallback, openai = production-grade remote embeddings, disabled = turn off indexing/search
SEMANTIC_EMBEDDING_PROVIDER="hash"
SEMANTIC_EMBEDDING_MODEL="hash-v1"
SEMANTIC_EMBEDDING_DIMENSIONS=256
# Optional override for OpenAI-compatible embedding endpoints
OPENAI_EMBEDDING_ENDPOINT=""
SEMANTIC_INDEX_ENABLED=1
SEMANTIC_INDEX_BATCH_SIZE=100
SEMANTIC_INDEX_MAX_BATCHES=10

# --------------------------------------------
# Health Checks
# --------------------------------------------
# In staging we usually allow billing to be optional so health checks stay green
# before Stripe secrets are wired. Set to 1 to force billing readiness, or 0 to
# make billing explicitly optional in every environment.
HEALTHCHECK_REQUIRE_BILLING=""

# --------------------------------------------
# Payments
# --------------------------------------------
# Stripe hosted checkout is the default gateway outside Nigeria.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Legacy fallback prices (kept for backwards compatibility)
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_EMPLOYER_BASIC_MONTHLY=""
STRIPE_PRICE_EMPLOYER_PREMIUM_MONTHLY=""
# Preferred provider catalog for regional recurring prices:
# key format = PLAN:REGION:INTERVAL:CURRENCY
# Example:
# {"BASIC:ROW:MONTHLY:USD":"price_123","BASIC:EUROPE:MONTHLY:EUR":"price_456"}
STRIPE_PRICE_CATALOG_JSON=""

# Flutterwave powers Nigeria-first recurring billing.
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
# Example:
# {"BASIC:AFRICA:MONTHLY:NGN":"12345","PROFESSIONAL:AFRICA:MONTHLY:NGN":"12346"}
FLUTTERWAVE_PLAN_CATALOG_JSON=""
# Comma-separated Flutterwave payment rails to show in hosted checkout.
FLUTTERWAVE_PAYMENT_OPTIONS="card,banktransfer,ussd"

# --------------------------------------------
# ATS Integration Security
# --------------------------------------------
# 32+ char secret used to encrypt ATS access/refresh tokens at rest.
ATS_TOKEN_ENCRYPTION_KEY=""

# --------------------------------------------
# Mock Interview Controls
# --------------------------------------------
# Default retention window (days) for interview media/transcript artifacts.
MOCK_INTERVIEW_RETENTION_DAYS=30

# --------------------------------------------
# Phase 4 Moat Features (all disabled by default)
# --------------------------------------------
PHASE4_SOCIAL_ENABLED=0
PHASE4_SALARY_NEGOTIATION_ENABLED=0
PHASE4_UNIVERSITY_API_ENABLED=0
PHASE4_EMPLOYER_AI_ENABLED=0
PHASE4_BOTS_ENABLED=0

# Secret used to authenticate inbound WhatsApp/Telegram webhook bridge requests.
BOT_WEBHOOK_SECRET=""

# --------------------------------------------
# AI Skills (premium features)
# --------------------------------------------
# Master feature flag — set to false to disable all AI skill routes
SKILLS_ENABLED=true

# OpenAI API key — used exclusively for text-embedding-3-small (job matching)
# Claude (ANTHROPIC_API_KEY) handles all text generation
OPENAI_API_KEY=""

# --------------------------------------------
# AI Mock Mode
# --------------------------------------------
# Set to 1 for testing without Claude API
MOCK_AI=0

# --------------------------------------------
# AI Models
# --------------------------------------------
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_QUALITY_MODEL=claude-sonnet-4-6

# --------------------------------------------
# Orchestrator Limits
# --------------------------------------------
ORCHESTRATOR_TOKEN_BUDGET_MAX=120000

# --------------------------------------------
# AI Controls
# --------------------------------------------
AI_DISABLED=0
DAILY_APPLY_PACK_LIMIT=5
DAILY_JOB_MATCH_LIMIT=20
DAILY_RESUME_REVIEW_LIMIT=10
