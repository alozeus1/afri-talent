# ─────────────────────────────────────────────────────────────────────────────
# AfriTalent free-tier backend — environment
# Copy to .env in this directory and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Neon connection string (Dashboard → your project → Connect → "Pooled connection")
# Must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 64
JWT_SECRET=""

# Your Vercel frontend URL (no trailing slash), e.g. https://afritalent.vercel.app
FRONTEND_URL=""

# Allow your Vercel preview URLs through CORS (keep as-is unless you know better)
ALLOWED_ORIGIN_REGEX="^https://[a-z0-9-]+\.vercel\.app$"

# Domain Caddy should serve the API on (DNS A record → this VM's IP).
# Use "localhost" for local, no-TLS testing.
API_DOMAIN="localhost"

# ── AI (required for AI features; leave empty to run without AI) ──────────────
ANTHROPIC_API_KEY=""
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_QUALITY_MODEL=claude-sonnet-4-6
AI_DISABLED=0

# ── Email (optional — AWS SES; pennies/month) ─────────────────────────────────
AWS_REGION=us-east-1
SES_REGION=us-east-1
SES_FROM_EMAIL=""
# IAM user credentials scoped to SES + S3 only
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Uploads (optional — S3 bucket for resumes/photos) ─────────────────────────
S3_UPLOADS_BUCKET=""

# ── Blog automation (optional) ────────────────────────────────────────────────
BLOG_AUTOMATION_ENABLED=1
BLOG_ADMIN_NOTIFICATION_EMAIL=""
NEWS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""
# Admin JWT used by blog-weekly-cron.sh to call the trigger endpoint
# (create an admin user, log in, copy the token)
BLOG_TRIGGER_ADMIN_TOKEN=""

# ── Job aggregation (all optional — free sources work without keys) ───────────
ADZUNA_APP_ID=""
ADZUNA_API_KEY=""

# ── Feature flags (safe defaults) ─────────────────────────────────────────────
SKILLS_ENABLED=true
PHASE4_BOTS_ENABLED=0
LANGGRAPH_ENABLED=0
