{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_UNHANDLED_REJECTION_FILTER=disabled jest --runInBand",
    "test:unit:watch": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_UNHANDLED_REJECTION_FILTER=disabled jest --watch",
    "test:unit:shard:1": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_UNHANDLED_REJECTION_FILTER=disabled jest --runInBand --shard=1/2",
    "test:unit:shard:2": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_UNHANDLED_REJECTION_FILTER=disabled jest --runInBand --shard=2/2",
    "test:unit:ci": "npm run test:unit:shard:1 && npm run test:unit:shard:2",
    "test:e2e": "playwright test",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:perf:lighthouse": "npx @lhci/cli@0.14.x autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.43.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "flatted": "3.4.2",
    "handlebars": "4.7.9",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "postcss": "8.5.14"
  }
}
