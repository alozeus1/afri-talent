# Frontend environment (copy to .env.local for `npm run dev`).
# NEXT_PUBLIC_* values are inlined at BUILD time: for Docker, pass them as
# --build-arg (docker-compose.yml does this), not as runtime env.

# Browser-facing API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Free launch: "true" removes paywalls, upgrade CTAs, plan pickers and Premium
# badges, and turns /pricing into a "free for everyone" page. Any other value
# (or unset) keeps the paid UI. Pair with the backend FREE_MODE=true flag.
NEXT_PUBLIC_FREE_MODE=true

# Server-only, read at runtime: URL SSR uses to reach the backend. In Docker
# Compose this is the service name (http://backend:4000); locally it can be
# left unset to fall back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://localhost:4000
